#!/bin/sh
# Builds the toolchain image and runs the check command in it with the network
# switched off. The workflow and the developer both run exactly this (ADR 0045).
#
# The tests that need the container engine cannot run in that image. They are
# compiled in it, with the network off, and run on the host (ADR 0049). They
# run always on the host's runner (GITHUB_ACTIONS=true), and on the developer's
# machine only with --engine: a test built from a card's branch would otherwise
# run there with the home directory in reach, on the engine that hosts other
# work (ADR 0048).
#
# The engine part runs only the engine tests, the tests that read
# KILN_ENGINE_TESTS, as "go run ./check engine-tests" finds them. The other
# tests of those packages are unit tests and run in the check, in the image
# (ADR 0045), so that every test runs once per check: run beside the engine
# tests they took a second time what the check already took.
#
# With --check-only it runs the check and no engine part, also on the host's
# runner. With --engine-only <package> it runs only that package's engine
# tests and no check; on the developer's machine that counts as a yes, as
# --engine does. The workflow runs the two in jobs side by side, one engine
# job per package, each on a runner of its own.
#
# With --compile-only, on the Git host's runner, it compiles what the check
# and the engine part compile, runs none of it, and so fills Go's build cache
# in KILN_GO_CACHE. The workflow cache, on a push to main, saves that cache;
# it runs no code of the repo but this script, the workflows and the
# toolchain image's Dockerfile.
#
# With --install-only, on the Git host's runner only, it runs the fresh-install
# test, TestFreshInstall of check/, which follows docs/getting-started.md on
# this engine (ADR 0061). It compiles the test with the network off, as the
# engine part does, then removes every image named kiln-* and the builder's
# cache, so that the guide's build is a first one, and runs it. The test uses
# the instance's fixed names and port, so it never runs on the developer's
# machine.
set -eu

usage() {
    echo "usage: check/in-image [--engine | --compile-only | --check-only | --engine-only <package> | --install-only]" >&2
    exit 2
}

engine=
compile=
check=1
check_only=
only=
install=
case "${1-}" in
    --engine) engine=1 ;;
    --compile-only) compile=1 ;;
    --check-only) check_only=1 ;;
    --install-only) install=1 check= ;;
    --engine-only)
        [ -n "${2-}" ] || usage
        engine=1 check= only=$2
        shift
        ;;
    "") ;;
    *) usage ;;
esac
[ "$#" -le 1 ] || usage

if [ -n "$install" ] && [ "${GITHUB_ACTIONS-}" != true ]; then
    echo "check/in-image: --install-only runs only on the Git host's runner (GITHUB_ACTIONS=true): it removes the engine's kiln-* images, and its test uses the instance's fixed names, kiln-proxy, the network kiln and port 4747" >&2
    exit 2
fi

# Go's build cache, on the Git host's runner only: there the directory comes
# from a cache that only a push to main saves, and is thrown away with the
# machine. On the developer's machine one card's check would write what the
# next check's engine-test programs are compiled from, and those run on the
# host (ADR 0048).
gocache=
if [ -n "${KILN_GO_CACHE-}" ]; then
    if [ "${GITHUB_ACTIONS-}" = true ]; then
        case "$KILN_GO_CACHE" in
            /*) gocache=$KILN_GO_CACHE ;;
            *) echo "check/in-image: KILN_GO_CACHE must be an absolute path" >&2; exit 2 ;;
        esac
    else
        echo "check/in-image: KILN_GO_CACHE is used on the Git host's runner only, and ignored here" >&2
    fi
fi
if [ -n "$compile" ] && [ -z "$gocache" ]; then
    echo "check/in-image: --compile-only needs KILN_GO_CACHE, an absolute path, on the Git host's runner" >&2
    exit 2
fi
[ -n "$gocache" ] && mkdir -p "$gocache"
[ "${GITHUB_ACTIONS-}" = true ] && [ -z "$compile" ] && [ -z "$check_only" ] && [ -z "$install" ] && engine=1

root=$(cd "$(dirname "$0")/.." && pwd)
image=kiln-toolchain

# engine_target sets goos and goarch, the machine the engine tests run on,
# and packages, the packages with engine tests: with --engine-only, the one
# it names, which must be one of them.
engine_target() {
    # The test program is built for the machine it runs on, not for the image.
    case "$(uname -s)" in
        Darwin) goos=darwin ;;
        Linux) goos=linux ;;
        *) echo "engine tests: unsupported system $(uname -s)" >&2; exit 2 ;;
    esac
    case "$(uname -m)" in
        arm64 | aarch64) goarch=arm64 ;;
        x86_64) goarch=amd64 ;;
        *) echo "engine tests: unsupported machine $(uname -m)" >&2; exit 2 ;;
    esac

    packages=
    for pkg in internal/seal internal/run internal/tick; do
        if [ -n "$only" ]; then
            [ "$pkg" = "$only" ] && packages=./$pkg
        elif [ -d "$root/$pkg" ]; then
            packages="$packages ./$pkg"
        fi
    done
    [ -n "$only" ] && [ -z "$packages" ] && usage
    return 0
}

# A package that --engine-only does not know ends here, before any build.
[ -n "$only" ] && engine_target

# The context is exactly go.mod, go.sum and the Dockerfile: the image downloads
# the modules of the first two, and nothing else of the repo is sent to the engine.
# The image carries the SHA-256 of these three files as the label kiln.context,
# and an image of that name with the same label is taken as it is: on the
# runner it is the one loaded from the cache. The names are relative, so the
# digest does not depend on where the repo is.
digest=$(cd "$root" && shasum -a 256 go.mod go.sum images/toolchain/Dockerfile | shasum -a 256 | cut -c1-64)
# Without this guard an image with no label would match an empty digest.
case "$digest" in
    "" | *[!0-9a-f]*) digest= ;;
esac
if [ "${#digest}" -ne 64 ]; then
    echo "check/in-image: cannot take the digest of the toolchain image's context" >&2
    exit 2
fi
if [ "$(docker image inspect --format '{{ index .Config.Labels "kiln.context" }}' "$image" 2>/dev/null || true)" = "$digest" ]; then
    echo "== toolchain image: built from this context before, not built again"
else
    tar -C "$root" -cf - go.mod go.sum images/toolchain/Dockerfile |
        docker build --quiet --label "kiln.context=$digest" --tag "$image" --file images/toolchain/Dockerfile - >/dev/null
fi

# --compile-only: one container compiles everything the check and the engine
# part compile. A command that fails prints its output and the next one runs:
# a broken main only means less in the cache. Test programs are built with
# -c and never run, and the check is built, not run.
if [ -n "$compile" ]; then
    engine_target
    docker run --rm --network none \
        --volume "$root:/src:ro" --workdir /src \
        ${gocache:+--volume "$gocache:/gocache" --env GOCACHE=/gocache} \
        "$image" sh -c '
            goos=$1 goarch=$2
            shift 2
            compile() {
                echo "== compile: $*"
                "$@" || echo "== compile: failed, going on"
            }
            mkdir /tmp/all /tmp/engine
            compile go vet ./...
            compile env GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /dev/null ./...
            compile go test -c -o /tmp/all/ ./...
            compile env GOOS="$goos" GOARCH="$goarch" CGO_ENABLED=0 go test -c -o /tmp/engine/ "$@"
            compile go build -o /dev/null ./check
            exit 0' sh "$goos" "$goarch" $packages
    exit 0
fi

# --install-only: the test program of check/, built for this machine with
# the network off, then a fresh engine, then the test, from check/ as go test
# would run it. The program goes outside the repo, which stays as it is.
if [ -n "$install" ]; then
    engine_target
    tests=$(mktemp -d)
    echo "== install test: compiling"
    docker run --rm --network none \
        --volume "$root:/src:ro" --workdir /src \
        ${gocache:+--volume "$gocache:/gocache" --env GOCACHE=/gocache} \
        --env GOOS="$goos" --env GOARCH="$goarch" --env CGO_ENABLED=0 \
        "$image" sh -c 'go test -c -o /tmp/check.test ./check && cat /tmp/check.test' \
        >"$tests/check.test" || { echo "== install test: compiling it failed" >&2; exit 1; }
    chmod +x "$tests/check.test"
    echo "== install test: removing the engine's kiln-* images and the builder's cache"
    ids=$(docker image ls --format '{{.ID}} {{.Repository}}' | awk '$2 ~ /^kiln-/ { print $1 }' | sort -u)
    # One word per image ID.
    [ -z "$ids" ] || docker image rm --force $ids >/dev/null
    docker builder prune --all --force >/dev/null
    cd "$root/check"
    exec env KILN_INSTALL_TEST=1 "$tests/check.test" -test.run '^TestFreshInstall$' -test.v -test.timeout=45m
fi

# The engine tests run in the background beside the check, if there is one:
# see engine below.
status=0
if [ -n "$engine" ]; then
    engine_target

    out=$(mktemp -d)
    # Output is printed by whoever holds $out/print: the check, if there is
    # one, then each package as it ends, so that nothing mixes.
    [ -z "$check" ] || mkdir "$out/print"
fi

# One check on this machine at a time runs its engine tests. Every run takes a
# network of its own, and the engine has about thirty IPv4 subnets for all of
# them, the developer's instance's runs included: two checks side by side,
# each with three packages side by side, would run out of them. The lock is
# flock(2) on $engine_lock, taken in one step by perl on file descriptor 9,
# which the engine part opens and the test programs inherit: the system lets
# go of it once the last of them has ended, however they end.
engine_lock=${KILN_ENGINE_LOCK:-/tmp/kiln-engine-tests.flock}
take_engine_lock() {
    flock='use Fcntl ":flock"; open(my $f, ">&=", 9) or die "$!\n"; flock($f, LOCK_EX | ($ARGV[0] ? LOCK_NB : 0)) or exit 1'
    if ! perl -e "$flock" 1; then
        take
        echo "== engine tests wait for those of another check"
        give
        perl -e "$flock" 0
    fi
}

# take and give hand the output on (see out above). Once the script itself is
# gone, as after kill -9, nobody holds it, and the packages print as they end.
take() {
    until mkdir "$out/print" 2>/dev/null; do
        [ -d "$out" ] && kill -0 $$ 2>/dev/null || return 0
        sleep 0.1
    done
}
give() { rmdir "$out/print" 2>/dev/null || true; }

# started runs a command in the background, writes its process ID to
# $out/<name>.pid, where stop finds it, and waits for it.
started() {
    name=$1
    shift
    "$@" &
    echo $! >"$out/$name.pid"
    # Told to stop while it started.
    [ -e "$out/stop" ] && kill -TERM $! 2>/dev/null
    wait $!
}

# engine builds the test programs and runs the packages side by side, beside
# the check, each with its output kept apart and printed whole, under its
# heading, when the package ends and the check's output is out. Inside a
# package only a few tests run at a time (-test.parallel): three in
# internal/seal, whose cases depend on each other most, and six in the
# others. That keeps the networks of one check to about twenty. A test
# program ends after ten minutes at the latest (-test.timeout).
engine() {
    # A hang-up of the terminal must not end this part before its tests.
    trap '' HUP
    # The programs come out on standard output, as a tar: a directory of the
    # host's, such as the one mktemp makes on macOS, is not always visible to
    # the engine. One container builds them all, so the standard library is
    # compiled once. Beside each program <name>.test it writes <name>.run, the
    # -test.run pattern of the package's engine tests. Only go test -c gets
    # the host's GOOS and GOARCH: the check program runs in the container.
    if ! started build docker run --rm --network none \
        --volume "$root:/src:ro" --workdir /src \
        ${gocache:+--volume "$gocache:/gocache" --env GOCACHE=/gocache} \
        "$image" sh -c '
            set -e
            goos=$1 goarch=$2
            shift 2
            mkdir /tmp/tests
            env GOOS="$goos" GOARCH="$goarch" CGO_ENABLED=0 go test -c -o /tmp/tests/ "$@"
            go run ./check engine-tests "$@" >/tmp/engine-tests
            while read -r pkg pattern; do
                printf "%s\n" "$pattern" >"/tmp/tests/${pkg##*/}.run"
            done </tmp/engine-tests
            tar -C /tmp/tests -cf - .' sh "$goos" "$goarch" $packages \
        >"$out/tests.tar" 2>"$out/build.log" || ! tar -xf "$out/tests.tar" -C "$out" 2>>"$out/build.log"; then
        take
        echo "== engine tests: building them failed"
        cat "$out/build.log"
        give
        echo 1 >"$out/build.status"
        return
    fi
    exec 9>>"$engine_lock"
    take_engine_lock
    for pkg in $packages; do
        [ -e "$out/stop" ] && break
        name=$(basename "$pkg")
        parallel=6
        [ "$name" = seal ] && parallel=3
        (
            # Only the package's engine tests, and never none: a pattern
            # that is missing or empty would run every test or none.
            pattern=
            [ -e "$out/$name.run" ] && pattern=$(cat "$out/$name.run")
            if [ -z "$pattern" ]; then
                echo 1 >"$out/$name.status"
                take
                echo "== engine tests of ${pkg#./}: no engine test found"
                give
                exit 0
            fi
            # From the package's directory, as go test would.
            code=0
            started "$name" sh -c 'cd "$1" && shift && exec "$@"' sh "$root/$pkg" \
                env KILN_ENGINE_TESTS=1 "$out/$name.test" -test.v -test.run "$pattern" \
                -test.parallel=$parallel -test.timeout=10m \
                >"$out/$name.log" 2>&1 || code=$?
            echo "$code" >"$out/$name.status"
            take
            echo "== engine tests of ${pkg#./}"
            cat "$out/$name.log"
            give
        ) &
    done
    wait
}

# stop ends the script on a signal: it tells the check, the build of the
# tests and the test programs to stop, and waits for the engine part, whose
# test programs end the cases they run and clean up first (see stop_test.go
# in each package). The lock goes with the last of them.
stop() {
    trap '' INT TERM HUP
    set +e # a program that has ended already is fine
    echo "check/in-image: stopped; the engine tests end the cases they run and clean up" >&2
    [ -n "${check_pid-}" ] && kill -TERM "$check_pid" 2>/dev/null
    if [ -n "$engine" ]; then
        : >"$out/stop"
        for f in "$out"/*.pid; do
            [ -e "$f" ] && kill -TERM "$(cat "$f")" 2>/dev/null
        done
        # The packages print what they did as they end.
        [ -n "${check_pid-}" ] && give
        wait "$engine_pid" 2>/dev/null
        rm -rf "$out"
    fi
    exit "$1"
}

if [ -n "$engine" ]; then
    engine &
    engine_pid=$!
fi
trap 'stop 130' INT
trap 'stop 143' TERM
trap 'stop 129' HUP

# In the background, so that a signal is handled at once, not once the check
# has ended.
if [ -n "$check" ]; then
    docker run --rm --network none \
        --volume "$root:/src:ro" --workdir /src \
        ${gocache:+--volume "$gocache:/gocache" --env GOCACHE=/gocache} \
        "$image" go run ./check &
    check_pid=$!
    wait "$check_pid" || status=$?
    check_pid=
fi

if [ -n "$check_only" ]; then
    echo "engine tests not run here; check/in-image --engine-only <package> runs them"
    exit "$status"
fi
if [ -z "$engine" ]; then
    echo "engine tests not run; check/in-image --engine runs them"
    exit "$status"
fi

give
wait "$engine_pid"
for f in "$out"/*.status; do
    [ -e "$f" ] || continue
    code=$(cat "$f")
    [ "$code" = 0 ] || status=$code
done
for pkg in $packages; do
    # A package whose program did not run has no status.
    if [ ! -e "$out/build.status" ] && [ ! -e "$out/$(basename "$pkg").status" ]; then status=1; fi
done
rm -rf "$out"
exit "$status"
