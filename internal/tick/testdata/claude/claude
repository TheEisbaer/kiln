#!/bin/sh
# Stands in for Claude Code in the tick test, where Claude Code's behaviour is
# not under test. It prints only the three events that internal/run reads
# (events.go), with their fields as the pinned Claude Code 2.1.326 prints them:
# system/init with the --model it was given, one assistant event with a text
# and a tool use, which the screen shows as the run's activity, and a success
# result. In between it does what the instruction's stage asks, which it tells
# by the instruction's first line:
#
# - spec: it writes a short spec to /kiln/out/spec.md, with the five headings
#   and the card's word kiln-case-<name>, if it has one, and appends a line to
#   NOTES.md, the change a spec run must not save;
# - implement: it appends a line to NOTES.md, "A fix after the review." when it
#   is told a last review, and writes /kiln/out/report.md;
# - review: it writes /kiln/out/review.md, whose first line is "Verdict: goes
#   back" for a card with kiln-stand-in-goesback whose change has no fix yet,
#   and "Verdict: passes" otherwise, and appends a line to NOTES.md, which a
#   review run must not save.
#
# A word in the instruction, which comes on standard input, changes that:
# kiln-stand-in-gate makes it wait for /tmp/gate first; kiln-stand-in-nospec
# makes it write no spec, kiln-stand-in-longspec one of 262,145 bytes, and
# kiln-stand-in-escape one with ESC, CSI, OSC, a carriage return and a byte
# that is not UTF-8; kiln-stand-in-nochange makes an implement run change
# nothing; and kiln-stand-in-fail makes it exit 1 with no result, after the
# spec.
#
# The card that changes the pin in images/run/Dockerfile updates it. The tick
# test's run of the real Claude Code fails when an event or a field printed
# here has no counterpart of the same JSON type in the real output.
set -eu
model=
while [ $# -gt 0 ]; do
    case "$1" in
        --model) model=$2; shift 2 ;;
        *) shift ;;
    esac
done
instruction=$(cat)
printf '{"type":"system","subtype":"init","model":"%s","claude_code_version":"2.1.326"}\n' "$model"
printf '{"type":"assistant","message":{"content":[{"type":"text","text":"Reading the card."},{"type":"tool_use","name":"Bash","input":{"command":"cat NOTES.md","description":"Read the notes"}}]}}\n'
case "$instruction" in
    *kiln-stand-in-gate*)
        touch /tmp/waiting
        while [ ! -e /tmp/gate ]; do sleep 0.05; done ;;
esac
word=$(printf '%s\n' "$instruction" | grep -o 'kiln-case-[a-z0-9-]*' | head -n 1 || true)
case "$instruction" in
    "# Implement a card"*)
        case "$instruction" in
            *kiln-stand-in-nochange*) ;;
            *"## The last review"*) printf 'A fix after the review.\n' >> NOTES.md ;;
            *) printf 'A line from the implement run.\n' >> NOTES.md ;;
        esac
        printf '# Report %s\n\nAppended a line to NOTES.md.\n' "$word" > /kiln/out/report.md ;;
    "# Review a change"*)
        case "$instruction" in
            *"A fix after the review."*) printf 'Verdict: passes\n\nThe fix is in.\n' ;;
            *kiln-stand-in-goesback*) printf 'Verdict: goes back\n\n1. The spec: NOTES.md lacks the fix.\n' ;;
            *) printf 'Verdict: passes\n\nNo findings.\n' ;;
        esac > /kiln/out/review.md
        printf 'A line from the review.\n' >> NOTES.md ;;
    *)
        spec=/kiln/out/spec.md
        case "$instruction" in
            *kiln-stand-in-nospec*) ;;
            *kiln-stand-in-longspec*) head -c 262145 /dev/zero | tr '\0' x > "$spec" ;;
            *kiln-stand-in-escape*) printf '# Spec\n\033[2J\033]0;kiln\007\r\377\n' > "$spec" ;;
            *) printf '# Spec %s\n\nPull request title: `feat: %s`\n\n## 1. What will be built\n\n## 2. How to tell it works\n\n## 3. What was found\n\n## 4. Left out\n\n## 5. Questions\n' "$word" "$word" > "$spec" ;;
        esac
        case "$instruction" in
            *kiln-stand-in-fail*) exit 1 ;;
        esac
        printf 'A line from the run.\n' >> NOTES.md ;;
esac
printf '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":0.0001}\n'
