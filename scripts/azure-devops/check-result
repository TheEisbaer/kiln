#!/bin/sh
# The check result command for a repo on Azure DevOps, shipped with Kiln: a repo's settings name
# it as its `check_result_command`, with the path of the repo's copy as its one argument, which
# fixes the repo in the command:
#
#   "check_result_command": "<kiln>/scripts/azure-devops/check-result /path/to/copy.git"
#
# The core runs it for a card at the Git host with KILN_COMMIT, the published commit, and
# KILN_SINCE, the card's feedback mark, and reads its last line: pending, passed, failed, closed
# or review.
#
# - closed: the commit has pull requests and every one was abandoned.
# - review: the commit's active pull request has feedback at or after KILN_SINCE: a text comment,
#   not deleted, in a thread not deleted, or a vote of waiting for author (-5) or rejected (-10),
#   by anyone but the pull request's creator, the same sign-in that published it. What is printed
#   before that line is the feedback, oldest first.
# - Otherwise the check: the pull request's blocking build policies (build validation), each for
#   the published commit. With failed, what is printed before that line is the failed tasks' log.
#   Optional builds, reviewers and work item links are not the check.
#
# It needs az with the azure-devops extension, signed in, git and jq. The contract
# (docs/settled.md, the check result command's contract): KILN_COMMIT is 40 lowercase hex digits
# and is only ever quoted; no check yet for the commit is pending; standard output carries only
# the log or the feedback and the result; anything that goes wrong goes to standard error with a
# non-zero exit. It only reads, with the developer's own az sign-in. No set -x anywhere.
set -eu

fail() { echo "azure-devops check-result: $1" >&2; exit 2; }

[ $# -eq 1 ] || fail "usage: check-result <path of the repo's copy>"
copy=$1

commit=${KILN_COMMIT:-}
case "$commit" in *[!0-9a-f]*|'') fail "KILN_COMMIT is not a commit." ;; esac
[ ${#commit} -eq 40 ] || fail "KILN_COMMIT is not 40 hex digits."
since=${KILN_SINCE:-}
case "$since" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
  *) fail "KILN_SINCE is not a time as YYYY-MM-DDTHH:MM:SSZ." ;;
esac

for tool in az git jq; do
  command -v "$tool" >/dev/null 2>&1 ||
    fail "$tool is not on the PATH; the command needs az with the azure-devops extension, git and jq."
done
az extension show --name azure-devops >/dev/null 2>&1 ||
  fail "az has no azure-devops extension: az extension add --name azure-devops"

# The Git host's coordinates, from the copy's origin as written, before any insteadOf. Only
# https://[<user>@]dev.azure.com/<org>/<project>/_git/<repo> is taken. The origin is never
# printed: it may hold a credential.
bad_origin() { fail "the copy's origin is not an Azure DevOps repository."; }
origin=$(git -C "$copy" config --get remote.origin.url) || bad_origin
case "$origin" in https://*) ;; *) bad_origin ;; esac
path=${origin#https://}
case "$path" in
  dev.azure.com/*) ;;
  *@dev.azure.com/*)
    user=${path%%@dev.azure.com/*}
    case "$user" in */*|*@*) bad_origin ;; esac
    path=${path#"$user"@} ;;
  *) bad_origin ;;
esac
path=${path#dev.azure.com/}
case "$path" in */*/_git/*) ;; *) bad_origin ;; esac
org=${path%%/*}; rest=${path#*/}
project=${rest%%/_git/*}; repo=${rest#*/_git/}
for segment in "$org" "$project" "$repo"; do
  case "$segment" in
    ''|.|..|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._%~-]*) bad_origin ;;
  esac
done
orgurl="https://dev.azure.com/$org"
project=$(printf '%s' "$project" | sed 's/%20/ /g')

# Every az call's output is taken first, with its status, and only then given to jq: a signed-out
# az must never read as an empty list.

# The active pull request whose source is the published commit, with its creator and the ids of
# its repository and project.
list=$(az repos pr list --organization "$orgurl" --project "$project" --repository "$repo" \
  --status active --top 1000 -o json) || fail "cannot list the pull requests (is az signed in?)."
found=$(printf '%s' "$list" | jq -r --arg commit "$commit" '
  [.[] | select(.lastMergeSourceCommit.commitId == $commit)][0] // empty
  | "\(.pullRequestId) \(.createdBy.id) \(.repository.id) \(.repository.project.id)"') ||
  fail "cannot read the list of pull requests."

# No active one: closed when the commit has pull requests and every one is abandoned (none
# completed); otherwise nothing to read yet.
if [ -z "$found" ]; then
  list=$(az repos pr list --organization "$orgurl" --project "$project" --repository "$repo" \
    --status all --top 1000 -o json) || fail "cannot list the pull requests (is az signed in?)."
  printf '%s' "$list" | jq -r --arg commit "$commit" '
    [.[] | select(.lastMergeSourceCommit.commitId == $commit) | .status]
    | if length > 0 and all(. == "abandoned") then "closed" else "pending" end' ||
    fail "cannot read the list of pull requests."
  exit 0
fi
read -r pr creator repo_id project_id <<EOF
$found
EOF
case "$pr" in ''|*[!0-9]*) fail "Azure DevOps gave no pull request number." ;; esac
for id in "$creator" "$repo_id" "$project_id"; do
  case "$id" in ''|*[!0-9A-Fa-f-]*) fail "Azure DevOps gave no ids for pull request $pr." ;; esac
done

# The feedback: comments and votes at or after KILN_SINCE by anyone but the creator. Dates are
# compared cut to the second, ids lower-cased without dashes. Oldest first, so that the newest
# is kept when the core keeps only the end.
threads=$(az devops invoke --organization "$orgurl" --area git --resource pullRequestThreads \
  --route-parameters project="$project_id" repositoryId="$repo_id" pullRequestId="$pr" \
  --api-version 7.1 -o json) || fail "cannot read the comments of pull request $pr (is az signed in?)."
feedback=$(printf '%s' "$threads" | jq -r --arg since "$since" --arg creator "$creator" '
  def id: ascii_downcase | gsub("-"; "");
  def second: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
  def value($name): .properties[$name]."$value" // null | if . == null then null else tostring end;
  ($since | second) as $since | ($creator | id) as $creator
  | [.value[]? | . as $thread
      | ((select(.isDeleted != true) | (.comments // [])[]
          | select(.commentType == "text" and .isDeleted != true
              and ((.author.id // "") | id) != $creator
              and (.publishedDate | second) >= $since)
          | {date: .publishedDate, who: .author.displayName, text: .content,
             file: $thread.threadContext.filePath,
             line: ($thread.threadContext.rightFileStart.line // $thread.threadContext.leftFileStart.line)}),
         (select(value("CodeReviewThreadType") == "VoteUpdate"
             and (value("CodeReviewVoteResult") == "-5" or value("CodeReviewVoteResult") == "-10")
             and ((value("CodeReviewVotedByTfId") // "") | id) != $creator
             and (.publishedDate | second) >= $since)
          | {date: .publishedDate,
             who: (value("CodeReviewVotedByDisplayName") // .comments[0].author.displayName),
             text: (if value("CodeReviewVoteResult") == "-5" then "voted: waiting for author" else "voted: rejected" end),
             file: null, line: null}))]
  | sort_by([(.date | second), .date])[]
  | "=== \(.who // "someone")\(if .file then ", \(.file)\(if .line then ":\(.line)" else "" end)" else "" end), \(.date)\n\(.text // "")"') ||
  fail "cannot read the comments of pull request $pr."
if [ -n "$feedback" ]; then
  printf '%s\n' "$feedback"
  echo review
  exit 0
fi

# Its blocking build policies, as "<status> <build id> <built source commit>" per line.
policies=$(az repos pr policy list --organization "$orgurl" --id "$pr" -o json) ||
  fail "cannot read the policies of pull request $pr (is az signed in?)."
builds=$(printf '%s' "$policies" | jq -r '.[] | select(.configuration.isBlocking and .configuration.type.displayName == "Build")
    | "\(.status) \(.context.buildId // "none") \(.context.lastMergeSourceCommitId // "none")"') ||
  fail "cannot read the policies of pull request $pr."
[ -n "$builds" ] || { echo passed; exit 0; }  # a repo with no build validation has no check

# A build for an older commit, or one not started, is not this commit's result yet.
failed=""
pending=0
while read -r status build built; do
  [ "$built" = "$commit" ] || { pending=1; continue; }
  case "$status" in
    approved|notApplicable) ;;  # notApplicable: its path filter does not cover the change
    rejected) failed="$failed $build" ;;
    *) pending=1 ;;  # queued, running, or not applicable yet
  esac
done <<EOF
$builds
EOF

if [ -z "$failed" ]; then
  [ "$pending" -eq 0 ] && echo passed || echo pending
  exit 0
fi

# For each failed build: the name and errors of each failed task, then its log without the
# timestamps. The core keeps only the end, so the summary comes last again.
summary=""
for build in $failed; do
  case "$build" in *[!0-9]*) fail "Azure DevOps gave no build number." ;; esac
  timeline=$(az devops invoke --organization "$orgurl" --area build --resource timeline \
    --route-parameters project="$project_id" buildId="$build" --api-version 7.1 -o json) ||
    fail "cannot read the timeline of build $build (is az signed in?)."
  records=$(printf '%s' "$timeline" | jq -c '[.records[] | select(.type == "Task" and .result == "failed")
      | {name, log: (.log.id // null), issues: [.issues[]? | select(.type == "error") | .message]}]') ||
    fail "cannot read the timeline of build $build."
  for row in $(printf '%s' "$records" | jq -r '.[] | @base64'); do
    task=$(printf '%s' "$row" | base64 -d)
    name=$(printf '%s' "$task" | jq -r .name)
    log=$(printf '%s' "$task" | jq -r '.log // empty')
    echo "=== build $build, failed task: $name"
    if [ -n "$log" ]; then
      case "$log" in *[!0-9]*) fail "Azure DevOps gave no log number for build $build." ;; esac
      lines=$(az devops invoke --organization "$orgurl" --area build --resource logs \
        --route-parameters project="$project_id" buildId="$build" logId="$log" --api-version 7.1 -o json) ||
        fail "cannot read log $log of build $build (is az signed in?)."
      printf '%s' "$lines" | jq -r '.value[]' | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' | tail -n 400
    fi
    summary="$summary
- build $build, $name: $(printf '%s' "$task" | jq -r '.issues | join(" | ") | .[0:500]')"
  done
done
echo "=== what failed:$summary"
echo failed
